# Backend API base URL.
NEXT_PUBLIC_API_URL=<your-backend-api-url>

# Azure Blob storage URL for restaurant images.
NEXT_PUBLIC_AZURE_BLOB_URL=<your-azure-blob-url>

# Frontend base URL for NextAuth callbacks.
NEXTAUTH_URL=<your-frontend-url>

# Shared secret for NextAuth.js session signing.
NEXTAUTH_SECRET=<your-nextauth-secret>

# Google OAuth client ID for sign-in.
GOOGLE_CLIENT_ID=<your-google-client-id>

# Google OAuth client secret for sign-in.
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
