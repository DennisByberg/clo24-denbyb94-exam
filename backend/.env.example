# Database connection
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Environment
DEBUG=<true-or-false>

# Authentication - Set to 'true' for development with mock user, 'false' for production with NextAuth
MOCK_AUTH=<true-or-false>

# NextAuth.js - Must match frontend NEXTAUTH_SECRET
NEXTAUTH_SECRET=<your-nextauth-secret>

# Security/CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:<frontend-port>,http://localhost:<backend-port>

# API Configuration
API_PREFIX=<api-prefix>
