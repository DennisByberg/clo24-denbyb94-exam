# PostgreSQL connection string for the backend database.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Enable mock authentication for development (true/false).
MOCK_AUTH=<true-or-false>

# Shared secret for NextAuth.js session signing.
NEXTAUTH_SECRET=<your-nextauth-secret>

# Comma-separated allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:<frontend-port>,http://localhost:<backend-port>